<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wyrd.Ecs.Debug</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <Version>0.1.0-alpha</Version>
    <Description>In-process debug/inspection server for Wyrd.Ecs.</Description>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
    <PackageReference Include="TypeGen" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wyrd.Ecs.Debug.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Wyrd.Ecs\Wyrd.Ecs.csproj" />
    <ProjectReference Include="..\..\Persistence\Json\Wyrd.Ecs.Persistence.Json\Wyrd.Ecs.Persistence.Json.csproj" />
    <ProjectReference Include="..\Wyrd.Ecs.Debug.Abstractions\Wyrd.Ecs.Debug.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wyrd.Ecs.Debug.Generators\Wyrd.Ecs.Debug.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="build\Wyrd.Ecs.Debug.targets" Pack="true" PackagePath="buildTransitive\Wyrd.Ecs.Debug.targets" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\index.html" Link="wwwroot/index.html" />
  </ItemGroup>

  <Target Name="_WyrdGenerateTypeScriptTypes" AfterTargets="CoreCompile">
    <!-- TypeGen loads the compiled assembly via reflection and needs its dependencies
         resolvable alongside it. CoreCompile only produces the intermediate obj/ output,
         not the bin/ copy (which also holds copied ProjectReference outputs and only exists
         after the full Build target chain finishes, too late for the embedding steps this
         must precede) - so the primary assembly and its ProjectReference outputs are staged
         into a fixed, config-independent folder tgconfig.json's "assemblies" can reference
         by a literal path. -->
    <ItemGroup>
      <_WyrdTypeGenStagingFiles Include="@(_ResolvedProjectReferencePaths)" />
      <_WyrdTypeGenStagingFiles Include="$(IntermediateOutputPath)$(TargetFileName)" />
    </ItemGroup>
    <Copy SourceFiles="@(_WyrdTypeGenStagingFiles)" DestinationFolder="$(BaseIntermediateOutputPath)typegen-staging" SkipUnchangedFiles="true" />
    <Exec Command="dotnet typegen generate -p ." />
  </Target>

  <Target Name="_WyrdBuildFrontend" AfterTargets="_WyrdGenerateTypeScriptTypes" BeforeTargets="_CalculateEmbeddedFilesManifestInputs;PrepareResourceNames">
    <Exec Command="npm ci" WorkingDirectory="frontend" Condition="!Exists('frontend/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="frontend" />
    <ItemGroup>
      <EmbeddedResource Include="wwwroot/js/app.js" Link="wwwroot/js/app.js" />
      <EmbeddedResource Include="wwwroot/css/app.css" Link="wwwroot/css/app.css" />
    </ItemGroup>
  </Target>

  <Target Name="_WyrdEmbedDebugGeneratorAnalyzer" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Wyrd.Ecs.Debug.Generators\Wyrd.Ecs.Debug.Generators.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_WyrdDebugGeneratorTargetPath" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_WyrdDebugGeneratorTargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
