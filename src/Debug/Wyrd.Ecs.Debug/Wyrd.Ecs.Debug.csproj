<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wyrd.Ecs.Debug</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <Version>0.1.0-alpha</Version>
    <Description>In-process debug/inspection server for Wyrd.Ecs.</Description>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TypeGen" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wyrd.Ecs.Debug.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Wyrd.Ecs\Wyrd.Ecs.csproj" />
    <ProjectReference Include="..\..\Persistence\Json\Wyrd.Ecs.Persistence.Json\Wyrd.Ecs.Persistence.Json.csproj" />
    <ProjectReference Include="..\Wyrd.Ecs.Debug.Abstractions\Wyrd.Ecs.Debug.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wyrd.Ecs.Debug.Generators\Wyrd.Ecs.Debug.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="build\Wyrd.Ecs.Debug.targets" Pack="true" PackagePath="buildTransitive\Wyrd.Ecs.Debug.targets" Visible="false" />
  </ItemGroup>

  <!-- Literal (non-wildcard) paths, so MSBuild records them as known Content items at
       project-evaluation time even though js/app.js and css/app.css don't exist on disk
       yet then - only a wildcard/glob Include needs matching files to exist at evaluation
       time. That's what makes these visible to both this project's own CopyToOutputDirectory
       pass and a downstream ProjectReference/PackageReference consumer's transitive content
       query, neither of which re-runs _WyrdBuildFrontend to discover items declared inside
       a target body (confirmed hands-on: that's the form that silently failed to propagate). -->
  <ItemGroup>
    <Content Include="wwwroot\index.html" Link="wwwroot/index.html" CopyToOutputDirectory="PreserveNewest"
      Pack="true" PackagePath="contentFiles/any/any/wwwroot/index.html" PackageCopyToOutput="true" />
    <Content Include="wwwroot\js\app.js" Link="wwwroot/js/app.js" CopyToOutputDirectory="PreserveNewest"
      Pack="true" PackagePath="contentFiles/any/any/wwwroot/js/app.js" PackageCopyToOutput="true" />
    <Content Include="wwwroot\css\app.css" Link="wwwroot/css/app.css" CopyToOutputDirectory="PreserveNewest"
      Pack="true" PackagePath="contentFiles/any/any/wwwroot/css/app.css" PackageCopyToOutput="true" />
  </ItemGroup>

  <Target Name="_WyrdGenerateTypeScriptTypes" AfterTargets="CoreCompile">
    <!-- TypeGen loads the compiled assembly via reflection and needs its dependencies
         resolvable alongside it. CoreCompile only produces the intermediate obj/ output,
         not the bin/ copy (which also holds copied ProjectReference outputs and only exists
         after the full Build target chain finishes, too late for the frontend build this
         must precede) - so the primary assembly and its ProjectReference outputs are staged
         into a fixed, config-independent folder tgconfig.json's "assemblies" can reference
         by a literal path. -->
    <ItemGroup>
      <_WyrdTypeGenStagingFiles Include="@(_ResolvedProjectReferencePaths)" />
      <_WyrdTypeGenStagingFiles Include="$(IntermediateOutputPath)$(TargetFileName)" />
    </ItemGroup>
    <Copy SourceFiles="@(_WyrdTypeGenStagingFiles)" DestinationFolder="$(BaseIntermediateOutputPath)typegen-staging" SkipUnchangedFiles="true" />
    <Exec Command="dotnet typegen generate -p ." />
  </Target>

  <!-- wwwroot/js/app.js and wwwroot/css/app.css are served from disk (Content, copied
       alongside the assembly), not embedded as resources. Embedding would need these files
       to exist before CoreCompile runs (resources are compiled into the assembly), but they
       can only exist after CoreCompile (TypeGen, which produces the .ts they're built from,
       needs the compiled assembly to reflect over) - a real cycle, not an ordering typo. -->
  <Target Name="_WyrdBuildFrontend" AfterTargets="_WyrdGenerateTypeScriptTypes">
    <Exec Command="npm ci" WorkingDirectory="frontend" Condition="!Exists('frontend/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="frontend" />
  </Target>

  <Target Name="_WyrdEmbedDebugGeneratorAnalyzer" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Wyrd.Ecs.Debug.Generators\Wyrd.Ecs.Debug.Generators.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_WyrdDebugGeneratorTargetPath" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_WyrdDebugGeneratorTargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
