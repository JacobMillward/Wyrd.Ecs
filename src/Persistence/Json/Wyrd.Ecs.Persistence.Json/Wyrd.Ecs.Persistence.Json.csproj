<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wyrd.Ecs.Persistence.Json</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <Version>0.1.0-alpha</Version>
    <Description>JSON snapshot codec for Wyrd.Ecs.Persistence.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wyrd.Ecs.Persistence.Json.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Wyrd.Ecs\Wyrd.Ecs.csproj" />
    <ProjectReference Include="..\..\Wyrd.Ecs.Persistence\Wyrd.Ecs.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wyrd.Ecs.Persistence.Json.Generators\Wyrd.Ecs.Persistence.Json.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Wyrd.Ecs.Persistence.Json.Generators\build\Wyrd.Ecs.Persistence.Json.Generators.targets"
          Pack="true"
          PackagePath="buildTransitive\Wyrd.Ecs.Persistence.Json.targets"
          Visible="false" />
  </ItemGroup>

  <Target Name="_WyrdEmbedJsonGeneratorTask" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Wyrd.Ecs.Persistence.Json.Generators\Wyrd.Ecs.Persistence.Json.Generators.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_WyrdJsonGeneratorTargetPath" />
    </MSBuild>
    <ItemGroup>
      <!--
        The same assembly serves two roles and is packed at both paths it needs to be
        found at: tasks/netstandard2.0/ for JsonContextEmitTask, the MSBuild Task the
        .targets file's UsingTask points at; analyzers/dotnet/cs/ for
        JsonRegistrationGenerator, the IIncrementalGenerator that emits
        ComponentCodecRegistry auto-registration and AddJsonPersistence(path)/(store) -
        without this second path, a consumer pulling this package in via a plain
        PackageReference gets the MSBuild task (so their project compiles) but never gets
        the generator wired in, so AddJsonPersistence never materializes. Roslyn's own
        generator/analyzer discovery already tolerates an assembly whose other types fail
        to load (it catches ReflectionTypeLoadException and keeps whatever types did
        load), which is what makes shipping one assembly both ways safe despite
        JsonContextEmitTask's own base type needing Microsoft.Build.Utilities.Core, an
        assembly no analyzer host loads.
      -->
      <None Include="@(_WyrdJsonGeneratorTargetPath)" Pack="true" PackagePath="tasks/netstandard2.0/" Visible="false" />
      <None Include="@(_WyrdJsonGeneratorTargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
