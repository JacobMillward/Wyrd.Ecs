<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Expected for a pure meta-package: no lib/net10.0 assembly exists to match the
         dependencies group, which NuGet's pack validation otherwise flags as NU5128. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Version>0.1.0-alpha</Version>
    <Description>Wyrd's full platform stack in one package: Wyrd.Ecs, Platform, Renderer, Input, Audio, and Assets. Does not include Debug or Persistence, which stay opt-in.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Wyrd.Ecs\Wyrd.Ecs.csproj" />
    <ProjectReference Include="..\Wyrd.Ecs.Platform\Wyrd.Ecs.Platform.csproj" />
    <ProjectReference Include="..\Renderer\Wyrd.Ecs.Renderer\Wyrd.Ecs.Renderer.csproj" />
    <ProjectReference Include="..\Input\Wyrd.Ecs.Input\Wyrd.Ecs.Input.csproj" />
    <ProjectReference Include="..\Audio\Wyrd.Ecs.Audio\Wyrd.Ecs.Audio.csproj" />
    <ProjectReference Include="..\Assets\Wyrd.Ecs.Assets\Wyrd.Ecs.Assets.csproj" />
  </ItemGroup>

</Project>
