<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Wyrd.Ecs.Renderer</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <Version>0.1.0-alpha</Version>
    <Description>SDL_GPU-based renderer for Wyrd.Ecs. Foundational device/swapchain/command-buffer lifecycle only; sprite/mesh rendering not yet implemented.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wyrd.Ecs.Renderer.Tests" />
    <InternalsVisibleTo Include="Wyrd.Ecs.Renderer.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.14.1" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.14.1" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.14.1" />
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.14.1" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="Silk.NET.Assimp" Version="2.23.0" />
    <PackageReference Include="Ultz.Native.Assimp" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Wyrd.Ecs\Wyrd.Ecs.csproj" />
    <ProjectReference Include="..\..\Wyrd.Ecs.Platform\Wyrd.Ecs.Platform.csproj" />
    <ProjectReference Include="..\..\Assets\Wyrd.Ecs.Assets\Wyrd.Ecs.Assets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Wyrd.Ecs.Generators\Wyrd.Ecs.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ShaderSource Include="Shaders/*.hlsl" />
  </ItemGroup>

  <!--
    BeforeTargets="AssignTargetPaths", not "CoreCompile" (unlike JsonContextEmitTask's
    precedent): the new EmbeddedResource items below need to exist before MSBuild assigns
    embedded-resource target paths, which happens earlier in the build than CoreCompile. This
    emits compiled shader bytes as data, not C# source consumed by CoreCompile itself, so the
    timing constraint that shaped JsonContextEmitTask doesn't apply here.
  -->
  <Target Name="CompileShaders" BeforeTargets="AssignTargetPaths"
          Inputs="@(ShaderSource)"
          Outputs="$(IntermediateOutputPath)Shaders/UnlitSprite.vert.spirv">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)../Wyrd.Ecs.Renderer.ShaderCompiler/Wyrd.Ecs.Renderer.ShaderCompiler.csproj&quot; -c $(Configuration) -- &quot;$(MSBuildThisFileDirectory)Shaders&quot; &quot;$(IntermediateOutputPath)Shaders&quot;" />
    <ItemGroup>
      <CompiledShaderFile Include="$(IntermediateOutputPath)Shaders/*" />
      <EmbeddedResource Include="@(CompiledShaderFile)" LogicalName="Wyrd.Ecs.Renderer.Shaders.%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
