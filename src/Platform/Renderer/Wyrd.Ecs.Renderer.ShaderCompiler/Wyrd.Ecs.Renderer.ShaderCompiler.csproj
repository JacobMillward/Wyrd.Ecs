<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.14.1" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.14.1" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.14.1" />
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.14.1" />
    <PackageReference Include="SDL3-CS.Windows.Shadercross" Version="3.0.0.9" />
    <PackageReference Include="SDL3-CS.Linux.Shadercross" Version="3.0.0.9" />
    <PackageReference Include="SDL3-CS.MacOS.Shadercross" Version="3.0.0.9" />
  </ItemGroup>
</Project>
