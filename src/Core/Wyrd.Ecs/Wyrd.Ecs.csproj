<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wyrd.Ecs</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <Version>0.1.0-alpha</Version>
    <Description>An archetype-based ECS for .NET, built around source generation and first-class persistence.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wyrd.Ecs.Tests" />
    <InternalsVisibleTo Include="Wyrd.Ecs.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wyrd.Ecs.InternalGenerators\Wyrd.Ecs.InternalGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wyrd.Ecs.Generators\Wyrd.Ecs.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="build\Wyrd.Ecs.props" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <Target Name="_WyrdEmbedGeneratorAnalyzer" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Wyrd.Ecs.Generators\Wyrd.Ecs.Generators.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_WyrdGeneratorTargetPath" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_WyrdGeneratorTargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
