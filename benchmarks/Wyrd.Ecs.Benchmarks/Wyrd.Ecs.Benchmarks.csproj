<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wyrd.Ecs.Benchmarks</RootNamespace>
    <!-- ProjectReference (below) doesn't import Wyrd.Ecs's packed build/Wyrd.Ecs.props,
         which sets this automatically for a real PackageReference consumer; see
         Wyrd.Ecs.PackagingTests. Set explicitly for this in-repo consumer instead. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Wyrd.Ecs</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="Friflo.Engine.ECS" Version="3.6.0" />
    <PackageReference Include="fennecs" Version="0.6.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Wyrd.Ecs\Wyrd.Ecs.csproj" />
    <ProjectReference Include="..\..\src\Persistence\Wyrd.Ecs.Persistence\Wyrd.Ecs.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Persistence\Continuous\Wyrd.Ecs.Persistence.Continuous\Wyrd.Ecs.Persistence.Continuous.csproj" />
    <ProjectReference Include="..\..\src\Persistence\Binary\Wyrd.Ecs.Persistence.Binary\Wyrd.Ecs.Persistence.Binary.csproj" />
  </ItemGroup>

</Project>
