<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Wyrd.Ecs.Examples.Asteroids</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The debug server inspects every component regardless of [PersistenceIgnore], which
         needs the ignored-types registration the JSON persistence generator only emits when
         this is set. -->
    <WyrdJsonRegisterIgnoredTypes>true</WyrdJsonRegisterIgnoredTypes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Wyrd.Ecs\Wyrd.Ecs.csproj" />
    <ProjectReference Include="..\..\src\Platform\Wyrd.Ecs.Engine\Wyrd.Ecs.Engine.csproj" />
    <ProjectReference Include="..\..\src\Core\Wyrd.Ecs.Generators\Wyrd.Ecs.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\Persistence\Wyrd.Ecs.Persistence\Wyrd.Ecs.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Persistence\Json\Wyrd.Ecs.Persistence.Json\Wyrd.Ecs.Persistence.Json.csproj" />
    <ProjectReference Include="..\..\src\Persistence\Json\Wyrd.Ecs.Persistence.Json.Generators\Wyrd.Ecs.Persistence.Json.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\Persistence\Wyrd.Ecs.Persistence.Generators\Wyrd.Ecs.Persistence.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\Debug\Wyrd.Ecs.Debug\Wyrd.Ecs.Debug.csproj" />
    <ProjectReference Include="..\..\src\Debug\Wyrd.Ecs.Debug.Generators\Wyrd.Ecs.Debug.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\..\src\Persistence\Json\Wyrd.Ecs.Persistence.Json.Generators\build\Wyrd.Ecs.Persistence.Json.Generators.targets" />

</Project>
